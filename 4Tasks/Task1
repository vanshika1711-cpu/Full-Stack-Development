<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>FlowTask</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#F8FAFC] text-[#0F172A]">

    <!-- Navbar -->
    <nav class="max-w-[1200px] mx-auto px-6 h-[72px] flex items-center justify-between">

        <h2 class="text-xl font-bold text-[#4F46E5]">
            FlowTask
        </h2>

        <!-- Desktop Links -->
        <div class="hidden sm:flex gap-8 text-sm font-medium">
            <a href="#">Features</a>
            <a href="#">Pricing</a>
            <a href="#">Docs</a>
        </div>

        <div class="hidden sm:flex items-center gap-5 text-sm">
            <a href="#">Login</a>
            <button class="bg-[#4F46E5] text-white px-4 py-2 rounded-md">
                Get Started
            </button>
        </div>

        <!-- Mobile Menu -->
        <button class="sm:hidden text-xl">
            ☰
        </button>

    </nav>


    <!-- Hero -->
    <section class="max-w-[1200px] mx-auto px-6 min-h-[520px] flex items-center">

        <div class="w-full text-center md:text-left">

            <p class="text-[#4F46E5] font-medium mb-3">
                Work Smarter
            </p>

            <h1 class="text-4xl md:text-5xl font-bold leading-tight max-w-[650px]">
                Build Better Products Faster With Our Platform
            </h1>

            <p class="text-[#475569] text-lg leading-relaxed mt-5 max-w-[650px]">
                Streamline your workflow, collaborate with your team
                and ship faster with our all-in-one platform.
            </p>

            <!-- Buttons -->
            <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center md:justify-start">

                <button class="bg-[#4F46E5] hover:bg-[#4338CA] text-white px-6 py-3 rounded-md">
                    Get Started
                </button>

                <button class="border border-[#4F46E5] text-[#4F46E5] px-6 py-3 rounded-md">
                    View Demo
                </button>

            </div>

        </div>

    </section>


    <!-- Features -->
    <section class="max-w-[1200px] mx-auto px-6 pb-12">

        <div class="text-center mb-12">

            <h2 class="text-3xl font-bold">
                Powerful Features
            </h2>

            <p class="text-[#475569] mt-2">
                Everything you need to build, manage and grow your product.
            </p>

        </div>


        <!-- Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

            <!-- Card 1 -->
            <div class="bg-white border border-[#E2E8F0] p-6 rounded-lg">

                

                <h3 class="text-xl font-semibold mb-2">
                    Fast & Reliable
                </h3>

                <p class="text-[#475569]">
                    Experience fast performance with reliable tools.
                </p>

            </div>


            <!-- Card 2 -->
            <div class="bg-white border border-[#E2E8F0] p-6 rounded-lg">


                <h3 class="text-xl font-semibold mb-2">
                    Team Collaboration
                </h3>

                <p class="text-[#475569]">
                    Work together easily with your team in real time.
                </p>

            </div>


            <!-- Card 3 -->
            <div class="bg-white border border-[#E2E8F0] p-6 rounded-lg">

                

                <h3 class="text-xl font-semibold mb-2">
                    Secure by Design
                </h3>

                <p class="text-[#475569]">
                    Keep your data safe with secure and simple tools.
                </p>

            </div>

        </div>

    </section>

</body>
</html>