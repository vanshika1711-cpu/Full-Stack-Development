<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ShopKart</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#F8FAFC] text-[#111827]">

    <!-- Navbar -->
    <nav class="bg-white border-b border-[#E5E7EB]">

        <div class="max-w-[1200px] mx-auto px-6">

            <div class="h-[70px] flex items-center justify-between">

                <h1 class="text-2xl font-bold text-[#2563EB]">
                    ShopKart
                </h1>

                <div class="hidden md:block w-[400px]">
                    <input
                        type="text"
                        placeholder="Search products..."
                        class="w-full border border-[#E5E7EB] rounded-md px-4 py-2 outline-none"
                    >
                </div>

                <div class="flex gap-5 items-center text-sm">

                    <a href="#" class="hidden sm:block">
                        Login
                    </a>

                    <button class="bg-[#2563EB] text-white px-4 py-2 rounded-md">
                        Cart
                    </button>

                </div>

            </div>


            <!-- Categories -->
            <div class="flex gap-7 pb-4 text-sm overflow-x-auto">

                <a href="#" class="text-[#2563EB] font-semibold">
                    All
                </a>

                <a href="#" class="text-[#6B7280]">
                    Laptops
                </a>

                <a href="#" class="text-[#6B7280]">
                    Mobiles
                </a>

                <a href="#" class="text-[#6B7280]">
                    Headphones
                </a>

                <a href="#" class="text-[#6B7280]">
                    Smart Watches
                </a>

                <a href="#" class="text-[#6B7280]">
                    Cameras
                </a>

            </div>

        </div>

    </nav>


    <!-- Main -->
    <main class="max-w-[1200px] mx-auto px-6 py-8">

        <div class="mb-7">

            <h2 class="text-3xl font-bold">
                Explore Products
            </h2>

            <p class="text-[#6B7280] mt-2">
                Find the latest products at the best prices.
            </p>

        </div>


        <!-- Main Layout -->
        <div class="flex gap-8">


            <!-- Sidebar -->
            <aside class="hidden lg:block w-[230px] shrink-0">

                <div class="bg-white border border-[#E5E7EB] rounded-lg p-5">

                    <h3 class="text-lg font-semibold mb-5">
                        Filters
                    </h3>


                    <!-- Category -->
                    <h4 class="font-semibold text-sm mb-3">
                        Category
                    </h4>

                    <div class="space-y-3 text-sm text-[#6B7280]">

                        <label class="flex gap-2">
                            <input type="checkbox">
                            Laptops
                        </label>

                        <label class="flex gap-2">
                            <input type="checkbox">
                            Mobiles
                        </label>

                        <label class="flex gap-2">
                            <input type="checkbox">
                            Headphones
                        </label>

                        <label class="flex gap-2">
                            <input type="checkbox">
                            Smart Watches
                        </label>

                        <label class="flex gap-2">
                            <input type="checkbox">
                            Cameras
                        </label>

                    </div>


                    <!-- Price -->
                    <h4 class="font-semibold text-sm mt-7 mb-3">
                        Price Range
                    </h4>

                    <div class="space-y-3 text-sm text-[#6B7280]">

                        <label class="flex gap-2">
                            <input type="checkbox">
                            Under ₹10,000
                        </label>

                        <label class="flex gap-2">
                            <input type="checkbox">
                            ₹10,000 - ₹30,000
                        </label>

                        <label class="flex gap-2">
                            <input type="checkbox">
                            ₹30,000 - ₹60,000
                        </label>

                        <label class="flex gap-2">
                            <input type="checkbox">
                            Above ₹60,000
                        </label>

                    </div>


                    <!-- Brand -->
                    <h4 class="font-semibold text-sm mt-7 mb-3">
                        Brand
                    </h4>

                    <div class="space-y-3 text-sm text-[#6B7280]">

                        <label class="flex gap-2">
                            <input type="checkbox">
                            Apple
                        </label>

                        <label class="flex gap-2">
                            <input type="checkbox">
                            Samsung
                        </label>

                        <label class="flex gap-2">
                            <input type="checkbox">
                            Sony
                        </label>

                    </div>


                    <button class="w-full bg-[#2563EB] text-white py-2 rounded-md mt-7 hover:bg-blue-700">
                        Apply Filters
                    </button>

                </div>

            </aside>


            <!-- Products -->
            <section class="flex-1">


                <!-- Top bar -->
                <div class="flex justify-between items-center mb-5">

                    <p class="text-sm text-[#6B7280]">
                        Showing 6 products
                    </p>

                    <select class="bg-white border border-[#E5E7EB] rounded-md px-3 py-2 text-sm">
                        <option>Sort by</option>
                        <option>Price Low to High</option>
                        <option>Price High to Low</option>
                        <option>Popular</option>
                    </select>

                </div>


                <!-- Mobile Filter -->
                <div class="flex gap-3 mb-5 lg:hidden">

                    <button class="bg-white border border-[#E5E7EB] px-5 py-2 rounded-md">
                        Filter
                    </button>

                    <button class="bg-white border border-[#E5E7EB] px-5 py-2 rounded-md">
                        Sort
                    </button>

                </div>


                <!-- Product Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">


                    <!-- Product 1 -->
                    <div class="bg-white border border-[#E5E7EB] rounded-xl overflow-hidden flex flex-col hover:shadow-lg">

                        <div class="relative h-[190px] overflow-hidden">

                            <span class="absolute top-3 left-3 z-10 bg-[#DC2626] text-white text-xs px-2 py-1 rounded">
                                SALE
                            </span>

                            <img
                                src="https://images.unsplash.com/photo-1541807084-5c52b6b3adef?w=500"
                                class="w-full h-full object-cover hover:scale-110 transition"
                            >

                        </div>

                        <div class="p-4 flex flex-col flex-1">

                            <p class="text-xs text-[#6B7280]">
                                Laptop
                            </p>

                            <h3 class="font-semibold mt-1">
                                Lenovo IdeaPad Slim
                            </h3>

                            <p class="text-[#F59E0B] text-sm mt-2">
                                ★★★★☆ 4.5
                            </p>

                            <div class="mt-2">
                                <span class="text-xl font-bold">
                                    ₹42,999
                                </span>

                                <span class="text-xs text-[#6B7280] line-through ml-2">
                                    ₹48,999
                                </span>
                            </div>

                            <button class="mt-4 bg-[#2563EB] text-white py-2 rounded-md hover:bg-blue-700">
                                Add to Cart
                            </button>

                        </div>

                    </div>


                    <!-- Product 2 -->
                    <div class="bg-white border border-[#E5E7EB] rounded-xl overflow-hidden flex flex-col hover:shadow-lg">

                        <div class="relative h-[190px] overflow-hidden">

                            <span class="absolute top-3 left-3 z-10 bg-green-600 text-white text-xs px-2 py-1 rounded">
                                NEW
                            </span>

                            <img
                                src="https://images.unsplash.com/photo-1598327105666-5b89351aff97?w=500"
                                class="w-full h-full object-cover hover:scale-110 transition"
                            >

                        </div>

                        <div class="p-4 flex flex-col flex-1">

                            <p class="text-xs text-[#6B7280]">
                                Mobile
                            </p>

                            <h3 class="font-semibold mt-1">
                                Samsung Galaxy S24
                            </h3>

                            <p class="text-[#F59E0B] text-sm mt-2">
                                ★★★★★ 4.8
                            </p>

                            <div class="mt-2">
                                <span class="text-xl font-bold">
                                    ₹59,999
                                </span>
                            </div>

                            <button class="mt-4 bg-[#2563EB] text-white py-2 rounded-md hover:bg-blue-700">
                                Add to Cart
                            </button>

                        </div>

                    </div>


                    <!-- Product 3 -->
                    <div class="bg-white border border-[#E5E7EB] rounded-xl overflow-hidden flex flex-col hover:shadow-lg">

                        <div class="relative h-[190px] overflow-hidden">

                            <img
                                src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500"
                                class="w-full h-full object-cover hover:scale-110 transition"
                            >

                        </div>

                        <div class="p-4 flex flex-col flex-1">

                            <p class="text-xs text-[#6B7280]">
                                Headphones
                            </p>

                            <h3 class="font-semibold mt-1">
                                Sony Wireless Headphones
                            </h3>

                            <p class="text-[#F59E0B] text-sm mt-2">
                                ★★★★☆ 4.6
                            </p>

                            <div class="mt-2">
                                <span class="text-xl font-bold">
                                    ₹8,499
                                </span>

                                <span class="text-xs text-[#6B7280] line-through ml-2">
                                    ₹10,999
                                </span>
                            </div>

                            <button class="mt-4 bg-[#2563EB] text-white py-2 rounded-md hover:bg-blue-700">
                                Add to Cart
                            </button>

                        </div>

                    </div>


                    <!-- Product 4 -->
                    <div class="bg-white border border-[#E5E7EB] rounded-xl overflow-hidden flex flex-col hover:shadow-lg">

                        <div class="relative h-[190px] overflow-hidden">

                            <span class="absolute top-3 left-3 z-10 bg-[#DC2626] text-white text-xs px-2 py-1 rounded">
                                SALE
                            </span>

                            <img
                                src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500"
                                class="w-full h-full object-cover hover:scale-110 transition"
                            >

                        </div>

                        <div class="p-4 flex flex-col flex-1">

                            <p class="text-xs text-[#6B7280]">
                                Smart Watch
                            </p>

                            <h3 class="font-semibold mt-1">
                                Apple Watch Series 9
                            </h3>

                            <p class="text-[#F59E0B] text-sm mt-2">
                                ★★★★★ 4.9
                            </p>

                            <div class="mt-2">
                                <span class="text-xl font-bold">
                                    ₹39,999
                                </span>
                            </div>

                            <button class="mt-4 bg-[#2563EB] text-white py-2 rounded-md hover:bg-blue-700">
                                Add to Cart
                            </button>

                        </div>

                    </div>


                    <!-- Product 5 -->
                    <div class="bg-white border border-[#E5E7EB] rounded-xl overflow-hidden flex flex-col hover:shadow-lg">

                        <div class="relative h-[190px] overflow-hidden">

                            <span class="absolute top-3 left-3 z-10 bg-green-600 text-white text-xs px-2 py-1 rounded">
                                NEW
                            </span>

                            <img
                                src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=500"
                                class="w-full h-full object-cover hover:scale-110 transition"
                            >

                        </div>

                        <div class="p-4 flex flex-col flex-1">

                            <p class="text-xs text-[#6B7280]">
                                Camera
                            </p>

                            <h3 class="font-semibold mt-1">
                                Canon EOS Camera
                            </h3>

                            <p class="text-[#F59E0B] text-sm mt-2">
                                ★★★★☆ 4.7
                            </p>

                            <div class="mt-2">
                                <span class="text-xl font-bold">
                                    ₹54,999
                                </span>
                            </div>

                            <button class="mt-4 bg-[#2563EB] text-white py-2 rounded-md hover:bg-blue-700">
                                Add to Cart
                            </button>

                        </div>

                    </div>


                    <!-- Product 6 -->
                    <div class="bg-white border border-[#E5E7EB] rounded-xl overflow-hidden flex flex-col hover:shadow-lg">

                        <div class="relative h-[190px] overflow-hidden">

                            <img
                                src="https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=500"
                                class="w-full h-full object-cover hover:scale-110 transition"
                            >

                        </div>

                        <div class="p-4 flex flex-col flex-1">

                            <p class="text-xs text-[#6B7280]">
                                Tablet
                            </p>

                            <h3 class="font-semibold mt-1">
                                Apple iPad Air
                            </h3>

                            <p class="text-[#F59E0B] text-sm mt-2">
                                ★★★★☆ 4.6
                            </p>

                            <div class="mt-2">
                                <span class="text-xl font-bold">
                                    ₹49,999
                                </span>

                                <span class="text-xs text-[#6B7280] line-through ml-2">
                                    ₹55,999
                                </span>
                            </div>

                            <button class="mt-4 bg-[#2563EB] text-white py-2 rounded-md hover:bg-blue-700">
                                Add to Cart
                            </button>

                        </div>

                    </div>


                </div>

            </section>

        </div>

    </main>

</body>
</html>